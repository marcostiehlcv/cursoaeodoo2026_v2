<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!-- ###### Property Type -->  

        <record id="estate_property_category_view_list" model="ir.ui.view">
            <field name="name">estate.property.category.view.list</field>
            <field name="model">estate.property.category</field>
            <field name="arch" type="xml">
                <list string="Real Estate  Category" default_order="name desc">
                    <field name="name" />
                    <field name="code" />
                    <field name="active" />
                </list>
            </field>
        </record>

        <record id="estate_property_category_view_form" model="ir.ui.view">
            <field name="name">estate.property.category.view.form</field>
            <field name="model">estate.property.category</field>
            <field name="arch" type="xml">
                <form string="Real Estate Property Category">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="active" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Action -->
        <record id="estate_property_category_view_action" model="ir.actions.act_window">
            <field name="name">Property Category</field>
            <field name="res_model">estate.property.category</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
