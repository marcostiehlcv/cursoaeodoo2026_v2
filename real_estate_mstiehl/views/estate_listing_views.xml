<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View estate.listing View List -->
    <record id="view_estate_listing_list" model="ir.ui.view">
        <field name="name">view.estate.listing.list</field>
        <field name="model">estate.listing</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="listing_ref_code" />
                <field name="property_id" />
                <field name="type_id" />
                <field name="seller_id" />
                <field name="agent_id" />
                <field name="expected_price" />
                <field name="state" />
            </list>
        </field>
    </record>

    <!-- View estate.listing form -->
    <record id="view_estate_listing_form" model="ir.ui.view">
        <field name="name">view.estate.listing.form</field>
        <field name="model">estate.listing</field>
        <field name="arch" type="xml">
            <form string="Estate Listing">
                <header>
                    <!-- <button string="Publish" name="action_publish" type="object" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button string="Unpublish" name="action_draft" type="object" class="oe_highlight" invisible="state != 'in_analysis'"/>
                    <button string="Accept Offer" name="action_accept" type="object" class="oe_highlight btn-success" invisible="state != 'in_analysis'"/>
                    <button string="Reject Offer" name="action_accept" type="object" class="oe_highlight btn-danger" invisible="state != 'in_analysis'"/>
                    <button string="Reserved" name="action_reserved" type="object" class="oe_highlight" invisible="state != 'in_analysis'"/>
                    <field name="state" widget="statusbar"/> -->
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="listing_ref_code"/>
                        </h1>
                    </div>
                    <group> <field name="tags_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_edit_color': True}"/>  </group>
                    <group col="2">
                        <group>
                            <field name="name" />
                            <field name="listing_ref_code" />
                            <field name="property_id" />
                            <field name="type_id" />
                            <field name="seller_id" widget="many2one_avatar_user"/>
                            <field name="agent_id"  widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="selling_price" />
                            <field name="date_published" />
                            <field name="date_offer_accepted" />
                            <field name="date_reserved" />
                            <field name="date_sold" />
                            <field name="date_canceled" />
                        </group>
                    </group>
                    <group> <field name="description" /> </group>
                    <notebook>
                        <page name="Offers" string="Offers">
                            <field name="offer_ids" >
                                <list>
                                    <field name="partner_id"  widget="many2one_avatar_user"/>
                                    <field name="price" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action estate.listing -->
    <record id="estate_listing_view_action" model="ir.actions.act_window">
        <field name="name">Estate Listing</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">estate.listing</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Estate Listing.
            </p>
        </field>
    </record>

</odoo>
