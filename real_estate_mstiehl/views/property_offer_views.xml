<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <!-- ###### Properties -->

        <record id="estate_property_offer_view_list" model="ir.ui.view">
            <field name="name">estate.property.offer.view.list</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list string="Offers" default_order="create_date desc">
                    <field name="property_id" widget="many2one_avatar" />
                    <field name="partner_id" />
                    <field name="price" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="estate_property_offer_view_form" model="ir.ui.view">
            <field name="name">estate.property.offer.view.form</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <form string="Real Estate Property">
                    <header>
                        <button string="Analyse" name="action_in_analysis" type="object" class="oe_highlight" invisible="state !='submitted'"/>
                        <button string="Accept" name="action_in_analysis" type="object" class="oe_highlight" invisible="state =='in_analysis'"/>
                        <button string="Refuse" name="action_in_analysis" type="object" class="oe_highlight" invisible="state =='in_analysis'"/>
                        <button string="Analyse" name="action_in_analysis" type="object" class="oe_highlight" invisible="state !='submitted'"/>
                        <field name="state" widget="statusbar" statusbar_visible="submitted,in_analysis,accepted,refused,expired"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="property_id" />
                            <field name="partner_id" widget="many2one_avatar" />
                            <field name="price" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Action -->
        <record id="estate_property_offer_view_action" model="ir.actions.act_window">
            <field name="name">Property Offers</field>
            <field name="res_model">estate.property.offer</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
