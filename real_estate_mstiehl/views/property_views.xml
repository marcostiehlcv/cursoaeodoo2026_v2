<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <!-- ###### Properties -->

        <record id="estate_property_view_list" model="ir.ui.view">
            <field name="name">estate.property.view.list</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <list string="Real Estate Properties" default_order="date_register desc">
                    <field name="name" />
                    <field name="property_type_id" />
                    <field name="agent_id" />
                    <field name="seller_id" />
                    <field name="total_area" />
                    <field name="available" />
                    <field name="published" />
                    <field name="active" />
                </list>
            </field>
        </record>

        <record id="estate_property_view_form" model="ir.ui.view">
            <field name="name">estate.property.view.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string="Real Estate Property">
                    <sheet>
                        <field name="image_1920" widget='image' class="oe_avatar" options='{"preview_image": "avatar_128"}' readonly="1"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group><field name="tags_ids" widget="many2many_tags"/></group>
                        <group>
                            <group>
                                <field name="property_type_id" />
                                <field name="property_category_id" />
                            </group>
                            <group>
                                <field name="country_id"/>
                                <field name="address"/>
                                <field name="postcode"/>
                                <field name="google_maps_url"/>
                            </group>
                        </group>
                        <group col="3">
                            <group> <field name="published"/></group>
                            <group><field name="available" readonly="1" /></group>
                            <group><field name="active"/></group>
                        </group>
                        <group>
                            <group>
                                <field name="seller_id" widget="many2one_avatar" />
                                <field name="agent_id"  widget="many2one_avatar" />
                            </group>
                            <group>
                                <field name="country_id"/>
                                <field name="address"/>
                                <field name="postcode"/>
                                <field name="google_maps_url"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" />
                            <field name="bedrooms" />
                            <field name="bathrooms" />
                            <field name="garage" />
                            <field name="external_url" />
                            <field name="date_register" />
                            <field name="active" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Action -->
        <record id="estate_property_view_action" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
