<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_estate_property" model="ir.actions.report">
        <field name="name">Property</field>
        <field name="model">estate.</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_mstiehl.estate_property_rerpot</field>
        <field name="report_file">real_estate_mstiehl.estate_property_rerpot</field>
        <!-- <field name="paperformat_id" ref="hr.paperformat_hr_employee_badge"/> -->
        <field name="print_report_name">'Property - %s' % (object.property_ref_code)</field>
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="binding_type">report</field>
    </record>


    <template id="estate_property_report" name="Estate Property Report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    Teste <span t-field="o.property_ref_code" />
                </t>
            </t>
        </t>       
    </template>

</odoo>
